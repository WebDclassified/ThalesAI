# App
# DEMO_MODE=true forces the deterministic synthetic adapter (offline demo).
# Leave false/unset to collect REAL data from free public sources
# (Arbeitnow + RemoteOK job boards, GitHub, CoinGecko) with automatic
# synthetic fallback whenever a live source is unreachable.
DEMO_MODE=false
DATA_DIR=.data

# Your OpenAI-compatible API (server-only; never exposed to the browser)
# Default: a local Ollama model — free, unlimited, offline.
#   ollama serve && ollama pull qwen2.5:3b-instruct
# Any OpenAI-compatible provider also works (Groq, OpenRouter, OpenAI, ...).
# Leave blank to run entirely on the deterministic fallback planner.
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen2.5:3b-instruct

# Planner output mode. true = request structured JSON schema first, then retry
# with a plain JSON-only body if the provider rejects it. false = plain body only.
AI_JSON_SCHEMA=true
AI_TIMEOUT_MS=25000
